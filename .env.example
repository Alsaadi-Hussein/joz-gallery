APP_NAME="Joz Gallery"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=joz
DB_USERNAME=joz_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=



MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"


VITE_APP_NAME="${APP_NAME}"

# Media Library: conversions always run inside the request (shared hosting)
QUEUE_CONVERSIONS_BY_DEFAULT=false
IMAGE_DRIVER=gd

# First owner account, read by the seeder
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Set to false on the live site to skip the demo catalog
SEED_DEMO=true

# Order alerts: the bot token stays here, the chat id is in the admin Settings page
TELEGRAM_BOT_TOKEN=

# Mail gives up after this many seconds, so a slow server cannot hold a queue job
MAIL_TIMEOUT=5
