# Joz Gallery production settings.
# Copy to .env on the server and fill in the empty values. DEPLOY.md explains each step.
# Never commit the real .env.

# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
APP_NAME="Joz Gallery"
APP_ENV=production
# Must stay false on the live site: true shows passwords and code to visitors.
APP_DEBUG=false
# Created by: php artisan key:generate
APP_KEY=
# The live address with https://, no trailing slash. Links and image URLs use it.
APP_URL=https://example.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
# Logs: one file a day in storage/logs, kept for 14 days
# ------------------------------------------------------------------------------
LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# ------------------------------------------------------------------------------
# Database: created in cPanel under MySQL Databases
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# Only if backups fail with "mysqldump not found": the folder holding mysqldump, such as /usr/bin/
DB_DUMP_BINARY_PATH=
# Only if backups fail with a TLS error: --skip-ssl
DB_DUMP_EXTRA_OPTION=

# ------------------------------------------------------------------------------
# Sessions, cache and queue: no Redis or workers on shared hosting
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookies only travel over https. Set to false only while testing without SSL.
SESSION_SECURE_COOKIE=true

CACHE_STORE=file
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# ------------------------------------------------------------------------------
# Files and images
# ------------------------------------------------------------------------------
FILESYSTEM_DISK=public
MEDIA_DISK=public
# Conversions always run inside the request on shared hosting.
QUEUE_CONVERSIONS_BY_DEFAULT=false
# gd, or imagick if the host offers it. Either must support WebP.
IMAGE_DRIVER=gd
# Only for the fallback in DEPLOY.md when symlinks are disabled.
PUBLIC_DISK_ROOT=

# ------------------------------------------------------------------------------
# Email: SMTP from cPanel, under Email Accounts > Connect Devices
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
# Give up after this many seconds, so a slow mail server cannot hold a queue job.
MAIL_TIMEOUT=5

# ------------------------------------------------------------------------------
# Order alerts
# ------------------------------------------------------------------------------
# From @BotFather on Telegram. The chat id goes in the admin Settings page.
TELEGRAM_BOT_TOKEN=

# ------------------------------------------------------------------------------
# First owner account: read by db:seed. Remove the password after the first login.
# ------------------------------------------------------------------------------
ADMIN_EMAIL=
# At least 12 characters with upper and lower case letters, numbers and symbols.
ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# Store
# ------------------------------------------------------------------------------
# true loads the demo products into the database. Leave false on the live site.
SEED_DEMO=false
# Leave empty on normal cPanel hosting. Behind Cloudflare, use *
TRUSTED_PROXIES=

# ------------------------------------------------------------------------------
# Backups
# ------------------------------------------------------------------------------
# Where to send a message if a nightly backup fails.
BACKUP_NOTIFICATION_EMAIL=
# Optional password on the backup zip files, which hold customer data.
BACKUP_ARCHIVE_PASSWORD=
